NODE_ENV=development

# Generate independent, high-entropy values. Minimum 32 characters each.
JWT_SECRET=
JWT_REFRESH_SECRET=
INTERNAL_SERVICE_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Exactly 64 hexadecimal characters when encryption utilities are used.
ENCRYPTION_KEY=

REDIS_URL=redis://localhost:6379
EVENT_STREAM_KEY=sparkcrm:events

# Development-only. Startup rejects this in production.
ALLOW_DEV_OTP=false
PHONE_OTP_ENABLED=false
EXPOSE_ERROR_STACKS=false

# Optional one-time bootstrap. Set both email and password or neither.
OWNER_BOOTSTRAP_EMAIL=
OWNER_BOOTSTRAP_PASSWORD=
OWNER_BOOTSTRAP_NAME=System Owner
