# Copy to .env for local development. Never commit populated secrets.
NODE_ENV=development

# Host bindings
GATEWAY_BIND_ADDRESS=127.0.0.1
PORT_GATEWAY=8000
PORT_AUTH=8001
PORT_TENANT=8002
PORT_LEAD=8003
PORT_CALL=8004
PORT_WHATSAPP=8005
PORT_AUTOMATION=8006
PORT_ANALYTICS=8007
PORT_BILLING=8008
PORT_NOTIFICATION=8009
PORT_FORM=8010
PORT_MEETING=8011

# Local Compose infrastructure credentials; replace before first use.
MONGO_ROOT_USERNAME=replace-with-local-username
MONGO_ROOT_PASSWORD=replace-with-local-password
REDIS_PASSWORD=replace-with-local-password

# Use service DNS names when running through Docker Compose.
MONGO_URI_AUTH=mongodb://replace-with-local-username:replace-with-local-password@mongo:27017/sparkcrm_auth?authSource=admin
MONGO_URI_TENANTS=mongodb://replace-with-local-username:replace-with-local-password@mongo:27017/sparkcrm_tenants?authSource=admin
MONGO_URI_LEADS=mongodb://replace-with-local-username:replace-with-local-password@mongo:27017/sparkcrm_leads?authSource=admin
MONGO_URI_CALLS=mongodb://replace-with-local-username:replace-with-local-password@mongo:27017/sparkcrm_calls?authSource=admin
MONGO_URI_WHATSAPP=mongodb://replace-with-local-username:replace-with-local-password@mongo:27017/sparkcrm_whatsapp?authSource=admin
MONGO_URI_AUTOMATIONS=mongodb://replace-with-local-username:replace-with-local-password@mongo:27017/sparkcrm_automations?authSource=admin
MONGO_URI_ANALYTICS=mongodb://replace-with-local-username:replace-with-local-password@mongo:27017/sparkcrm_analytics?authSource=admin
MONGO_URI_BILLING=mongodb://replace-with-local-username:replace-with-local-password@mongo:27017/sparkcrm_billing?authSource=admin
MONGO_URI_NOTIFICATIONS=mongodb://replace-with-local-username:replace-with-local-password@mongo:27017/sparkcrm_notifications?authSource=admin
MONGO_URI_FORMS=mongodb://replace-with-local-username:replace-with-local-password@mongo:27017/sparkcrm_forms?authSource=admin
MONGO_URI_MEETINGS=mongodb://replace-with-local-username:replace-with-local-password@mongo:27017/sparkcrm_meetings?authSource=admin
REDIS_URL=redis://:replace-with-local-password@redis:6379

# Required cryptographic values. Generate independently for every environment.
JWT_SECRET=replace-with-at-least-64-random-characters
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace-with-a-different-64-character-random-value
JWT_REFRESH_EXPIRES_IN=30d
ENCRYPTION_KEY=replace-with-64-hex-characters

# Browser origins
FRONTEND_URL=http://localhost:5173
DASHBOARD_URL=http://localhost:5173

# Optional integrations. Keep blank until configured through a secret manager.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
EXOTEL_SID=
EXOTEL_TOKEN=
EXOTEL_CALLBACK_URL=
WABA_API_URL=https://graph.facebook.com/v21.0
WABA_TOKEN=
WABA_PHONE_NUMBER_ID=
WABA_WEBHOOK_VERIFY_TOKEN=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SparkCRM
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=ap-south-1
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_ACCESS_KEY=
CLOUDFLARE_TOKEN_VALUE=
CLOUDFLARE_ENDPOINT=
CLOUDFLARE_URL=
CLOUDFLARE_BUCKET_NAME=
CLOUDFLARE_REGION=auto

# Script credentials are empty by default and must use disposable accounts.
OWNER_EMAIL=
OWNER_PASSWORD=
TEST_LOGIN_EMAIL=
TEST_LOGIN_PASSWORD=
TEST_TENANT_PASSWORD=
TEST_EMAIL_OTP=
TEST_PHONE_OTP=
TEST_RAZORPAY_KEY_ID=
TEST_RAZORPAY_KEY_SECRET=
TEST_RAZORPAY_WEBHOOK_SECRET=
DEMO_ADMIN_PASSWORD=
TENANT_LOOKUP_EMAIL=
TENANT_DIAGNOSTIC_ID=

# Script safety switches are intentionally disabled by default.
ALLOW_OPS_MUTATIONS=false
ALLOW_TEST_MUTATIONS=false
ALLOW_TEST_UPLOADS=false
ALLOW_REMOTE_MIGRATION=false
MIGRATION_BACKUP_CONFIRMED=false
